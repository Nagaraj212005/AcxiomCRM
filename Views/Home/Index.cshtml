@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var cityLabels = JsonSerializer.Serialize(Model.CustomersByCity.Select(item => item.Label));
    var cityValues = JsonSerializer.Serialize(Model.CustomersByCity.Select(item => item.Value));
    var monthLabels = JsonSerializer.Serialize(Model.MonthlyGrowth.Select(item => item.Label));
    var monthValues = JsonSerializer.Serialize(Model.MonthlyGrowth.Select(item => item.Value));
}

<div class="page-heading">
    <div class="dashboard-heading">
        <p class="eyebrow mb-2">OVERVIEW</p>
        <h1 class="page-title">Dashboard</h1>
        <p class="text-secondary mb-0">A clear view of your customer relationships.</p>
    </div>
    <div class="dashboard-heading-controls">
        <form method="get" class="dashboard-date-filter" aria-label="Filter dashboard by date">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div><label for="from" class="form-label small mb-1">From</label><input id="from" name="from" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div><label for="to" class="form-label small mb-1">To</label><input id="to" name="to" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <button class="btn btn-sm btn-outline-primary" type="submit"><i class="bi bi-funnel me-1"></i>Apply dates</button>
            <a class="btn btn-sm btn-light" asp-action="Index">Clear</a>
        </form>
        <div class="dashboard-quick-actions">
            <a class="btn btn-primary" asp-controller="Customers" asp-action="Create"><i class="bi bi-person-plus me-2"></i>Add customer</a>
            <a class="btn btn-outline-primary" asp-controller="Leads" asp-action="Create"><i class="bi bi-person-lines-fill me-2"></i>Add lead</a>
            <a class="btn btn-outline-primary" asp-controller="Opportunities" asp-action="Create"><i class="bi bi-graph-up-arrow me-2"></i>Add opportunity</a>
            <a class="btn btn-outline-primary" asp-controller="FollowUps" asp-action="Create"><i class="bi bi-calendar-plus me-2"></i>Schedule follow-up</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div class="metric-icon"><i class="bi bi-people"></i></div>
            <div class="metric-label">Total customers</div>
            <div class="metric-value">@Model.CustomerCount</div>
            <a class="metric-link" asp-controller="Customers" asp-action="Index">View customers <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div class="metric-icon metric-icon-blue"><i class="bi bi-person-check"></i></div>
            <div class="metric-label">Active customers</div>
            <div class="metric-value">@Model.ActiveCustomerCount</div>
            <a class="metric-link" asp-controller="Customers" asp-action="Index" asp-route-status="Active">View active <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div class="metric-icon metric-icon-violet"><i class="bi bi-person-plus"></i></div>
            <div class="metric-label">New in 30 days</div>
            <div class="metric-value">@Model.NewCustomerCount</div>
            <span class="small text-secondary">Recently added</span>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div class="metric-icon metric-icon-amber"><i class="bi bi-calendar-check"></i></div>
            <div class="metric-label">Pending follow-ups</div>
            <div class="metric-value">@Model.PendingFollowUpCount</div>
            <a class="metric-link" asp-controller="Customers" asp-action="Index">Review customers <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3"><a class="metric-card metric-card-link text-decoration-none" asp-controller="Leads" asp-action="Index">
        <div class="metric-icon metric-icon-blue"><i class="bi bi-person-lines-fill"></i></div><div class="metric-label">Leads</div><div class="metric-value">@Model.LeadCount</div><span class="metric-link">@Model.QualifiedLeadCount qualified</span>
    </a></div>
    <div class="col-sm-6 col-xl-3"><a class="metric-card metric-card-link text-decoration-none" asp-controller="Opportunities" asp-action="Index">
        <div class="metric-icon metric-icon-violet"><i class="bi bi-graph-up-arrow"></i></div><div class="metric-label">Open opportunities</div><div class="metric-value">@Model.OpenOpportunityCount</div><span class="metric-link">View pipeline</span>
    </a></div>
    <div class="col-sm-6 col-xl-3"><a class="metric-card metric-card-link text-decoration-none" asp-controller="Opportunities" asp-action="Index">
        <div class="metric-icon metric-icon-amber"><i class="bi bi-currency-dollar"></i></div><div class="metric-label">Weighted pipeline</div><div class="metric-value">@Model.PipelineValue.ToString("C0")</div><span class="metric-link">Open deal value</span>
    </a></div>
    <div class="col-sm-6 col-xl-3"><a class="metric-card metric-card-link text-decoration-none" asp-controller="FollowUps" asp-action="Index">
        <div class="metric-icon"><i class="bi bi-calendar2-check"></i></div><div class="metric-label">Scheduled follow-ups</div><div class="metric-value">@Model.ScheduledFollowUpCount</div><span class="metric-link">Manage schedule</span>
    </a></div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <section class="panel h-100">
            <div class="panel-header">
                <div><h2 class="panel-title">Customers by city</h2><p class="text-secondary small mb-0">Top locations</p></div>
            </div>
            @if (Model.CustomersByCity.Count == 0)
            {
                <div class="empty-state compact"><p class="text-secondary mb-0">City data will appear as customer records are added.</p></div>
            }
            else
            {
                <div class="p-3"><canvas id="customersByCityChart" aria-label="Customers by city chart" role="img"></canvas></div>
            }
        </section>
    </div>
    <div class="col-lg-6">
        <section class="panel h-100">
            <div class="panel-header">
                <div><h2 class="panel-title">Customer growth</h2><p class="text-secondary small mb-0">New customers per month</p></div>
            </div>
            <div class="p-3"><canvas id="monthlyGrowthChart" aria-label="Monthly customer growth chart" role="img"></canvas></div>
        </section>
    </div>
</div>

<section class="panel mb-4">
    <div class="panel-header">
        <div><h2 class="panel-title">Recent customers</h2><p class="text-secondary small mb-0">The latest contacts added to your workspace</p></div>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Customers" asp-action="Index">All customers</a>
    </div>
    @if (Model.RecentCustomers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-person-lines-fill"></i></div>
            <h3>No customers yet</h3>
            <p class="text-secondary">Add your first customer to get your CRM started.</p>
            <a class="btn btn-primary" asp-controller="Customers" asp-action="Create">Add your first customer</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Customer</th><th>Company</th><th>City</th><th>Status</th><th>Added</th><th></th></tr></thead>
                <tbody>
                    @foreach (var customer in Model.RecentCustomers)
                    {
                        <tr>
                            <td><a class="table-primary-link" asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                            <td>@(string.IsNullOrWhiteSpace(customer.Company) ? "—" : customer.Company)</td>
                            <td>@(string.IsNullOrWhiteSpace(customer.City) ? "—" : customer.City)</td>
                            <td><span class="badge rounded-pill status-@customer.Status.ToString().ToLowerInvariant()">@customer.Status</span></td>
                            <td>@customer.CreatedDate.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="text-end"><a class="btn btn-light btn-sm" asp-controller="Customers" asp-action="Edit" asp-route-id="@customer.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
<section class="panel mt-4">
    <div class="panel-header"><div><h2 class="panel-title">Recent CRM activities</h2><p class="text-secondary small mb-0">Completed calls, meetings, emails, and tasks</p></div><a asp-controller="Activities" asp-action="Index" class="btn btn-outline-secondary btn-sm">All activities</a></div>
    @if (Model.RecentCrmActivities.Count == 0)
    {
        <div class="empty-state compact"><p class="text-secondary mb-0">No CRM activities have been recorded yet.</p></div>
    }
    else
    {
        <div class="activity-list">
            @foreach (var activity in Model.RecentCrmActivities)
            {
                <div class="activity-item"><span class="activity-dot"></span><div class="flex-grow-1"><span class="badge text-bg-light me-1">@activity.Type</span><strong>@activity.Subject</strong></div><time class="text-secondary small">@activity.ActivityDate.ToLocalTime().ToString("MMM d, h:mm tt")</time></div>
            }
        </div>
    }
</section>
<section class="panel">
    <div class="panel-header">
        <div><h2 class="panel-title">Recent activity</h2><p class="text-secondary small mb-0">Customer changes in your workspace</p></div>
    </div>
    @if (Model.RecentActivities.Count == 0)
    {
        <div class="empty-state compact"><p class="text-secondary mb-0">Customer activity will appear here.</p></div>
    }
    else
    {
        <div class="activity-list">
            @foreach (var activity in Model.RecentActivities)
            {
                <div class="activity-item">
                    <span class="activity-dot"></span>
                    <div class="flex-grow-1"><strong>@activity.UserName</strong> @activity.Action.ToLowerInvariant() <strong>@activity.CustomerName</strong></div>
                    <time class="text-secondary small" datetime="@activity.OccurredAt.ToString("O")">@activity.OccurredAt.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                </div>
            }
        </div>
    }
</section>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        const cityLabels = @Html.Raw(cityLabels);
        const cityValues = @Html.Raw(cityValues);
        const monthLabels = @Html.Raw(monthLabels);
        const monthValues = @Html.Raw(monthValues);
        const cityChart = document.getElementById('customersByCityChart');
        if (cityChart) {
            new Chart(cityChart, {
                type: 'bar',
                data: { labels: cityLabels, datasets: [{ label: 'Customers', data: cityValues, backgroundColor: '#4f46e5', borderRadius: 6 }] },
                options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });
        }
        new Chart(document.getElementById('monthlyGrowthChart'), {
            type: 'line',
            data: { labels: monthLabels, datasets: [{ label: 'New customers', data: monthValues, borderColor: '#0f766e', backgroundColor: 'rgba(15,118,110,.12)', fill: true, tension: .3 }] },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
