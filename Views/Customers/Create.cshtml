@model Customer
@{
    ViewData["Title"] = "Add customer";
}
<div class="page-heading">
    <div><p class="eyebrow mb-2">CUSTOMERS</p><h1 class="page-title">Add customer</h1><p class="text-secondary mb-0">Enter the contact details below.</p></div>
</div>
<div class="form-panel">
    <form asp-action="Create" method="post" data-loading>
        <partial name="_CustomerForm" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Create customer</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
