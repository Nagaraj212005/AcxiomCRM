@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcxiomCRM.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-layers-half"></i></span> AcxiomCRM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNavigation"
                        aria-controls="topNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="topNavigation">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav mobile-nav-links d-lg-none">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people me-2"></i>Customers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index"><i class="bi bi-person-lines-fill me-2"></i>Leads</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index"><i class="bi bi-graph-up-arrow me-2"></i>Opportunities</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index"><i class="bi bi-calendar-check me-2"></i>Follow-ups</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index"><i class="bi bi-clock-history me-2"></i>Activities</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart me-2"></i>Reports</a></li>
                            @if (User.IsInRole(CrmRoles.Admin)) { <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-2"></i>User management</a></li> }
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/ChangePassword"><i class="bi bi-shield-lock me-2"></i>Settings</a></li>
                        </ul>
                    }
                    <div class="ms-auto d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <span class="text-secondary small d-none d-lg-inline">@User.Identity?.Name</span>
                            <a class="btn btn-light btn-sm" asp-area="Identity" asp-page="/Account/Manage/Index" title="Profile">
                                <i class="bi bi-person-circle"></i><span class="ms-2 d-lg-none">Profile</span>
                            </a>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-box-arrow-right"></i><span class="ms-2">Logout</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">Log in</a>
                            <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Create account</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-shell">
        @if (SignInManager.IsSignedIn(User))
        {
            <aside class="sidebar">
                <div class="sidebar-label">Workspace</div>
                <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i><span>Dashboard</span>
                </a>
                <a class="sidebar-link" asp-controller="Customers" asp-action="Index">
                    <i class="bi bi-people"></i><span>Customers</span>
                </a>
                <a class="sidebar-link" asp-controller="Leads" asp-action="Index">
                    <i class="bi bi-person-lines-fill"></i><span>Leads</span>
                </a>
                <a class="sidebar-link" asp-controller="Opportunities" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i><span>Opportunities</span>
                </a>
                <a class="sidebar-link" asp-controller="FollowUps" asp-action="Index">
                    <i class="bi bi-calendar-check"></i><span>Follow-ups</span>
                </a>
                <a class="sidebar-link" asp-controller="Activities" asp-action="Index">
                    <i class="bi bi-clock-history"></i><span>Activities</span>
                </a>
                <a class="sidebar-link" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart"></i><span>Reports</span>
                </a>
                @if (User.IsInRole(CrmRoles.Admin))
                {
                    <a class="sidebar-link" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-person-gear"></i><span>User management</span>
                    </a>
                    <a class="sidebar-link" asp-controller="Audit" asp-action="Index">
                        <i class="bi bi-clipboard-data"></i><span>Audit log</span>
                    </a>
                }
                <div class="sidebar-label mt-4">Account</div>
                <a class="sidebar-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person"></i><span>Profile</span>
                </a>
                <a class="sidebar-link" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">
                    <i class="bi bi-shield-lock"></i><span>Settings</span>
                </a>
            </aside>
        }
        <main class="main-content">
            <div class="content-container">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        <i class="bi bi-check-circle me-2"></i>@successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>@errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
