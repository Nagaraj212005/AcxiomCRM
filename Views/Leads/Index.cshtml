@model IReadOnlyList<Lead>
@{
    ViewData["Title"] = "Leads";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h3 mb-1">Leads</h1><p class="text-secondary mb-0">Manage prospects and conversions.</p></div>
    <a asp-action="Create" class="btn btn-primary">Add lead</a>
</div>
<div class="card"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Lead</th><th>Company</th><th>Contact</th><th>Source</th><th>Status</th><th>Priority</th><th>Expected value</th><th></th></tr></thead>
        <tbody>
        @foreach (var lead in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@lead.Id">@lead.Name</a><div class="small text-secondary">@lead.LeadCode</div></td>
                <td>@lead.Company</td><td>@lead.Email<br />@lead.Phone</td><td>@lead.Source</td><td><span class="badge text-bg-light">@lead.Status</span></td><td>@lead.Priority</td><td>@lead.ExpectedValue.ToString("C")</td>
                <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@lead.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@lead.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this lead?');">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-secondary py-5">No leads yet.</td></tr> }
        </tbody>
    </table>
</div></div>
