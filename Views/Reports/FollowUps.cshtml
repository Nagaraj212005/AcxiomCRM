@model IReadOnlyList<FollowUp>
@{ ViewData["Title"] = "Follow-up report"; var pending = Model.Count(item => item.Status == FollowUpStatus.Planned); var overdue = Model.Count(item => item.Status == FollowUpStatus.Planned && item.FollowUpDate < DateTime.UtcNow); }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Follow-up report</h1><p class="text-secondary mb-0">@pending pending · @overdue overdue</p></div><button class="btn btn-outline-secondary" onclick="window.print()">Print</button></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Subject</th><th>Type</th><th>Status</th><th>Due</th><th>Customer</th><th>Lead</th><th>Opportunity</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Subject</td><td>@item.Type</td><td>@item.Status</td><td>@item.FollowUpDate.ToLocalTime().ToString("g")</td><td>@item.CustomerId</td><td>@item.LeadId</td><td>@item.OpportunityId</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-5">No follow-ups found.</td></tr> }
</tbody></table></div></div>
