@model IReadOnlyList<AuditLog>
@{ ViewData["Title"] = "User activity report"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">User activity report</h1><p class="text-secondary mb-0">Latest @Model.Count CRM events.</p></div><button class="btn btn-outline-secondary" onclick="window.print()">Print</button></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Module</th><th>Result</th><th>Details</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.CreatedDate.ToLocalTime().ToString("g")</td><td>@item.UserName</td><td>@item.Action</td><td>@item.Module</td><td>@item.Result</td><td>@item.Details</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-5">No activity recorded.</td></tr> }
</tbody></table></div></div>
