@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";

    string SortLink(string key) =>
        Model.SortOrder == key ? $"{key}_desc" : key;
}

<div class="page-heading">
    <div>
        <p class="eyebrow mb-2">RELATIONSHIPS</p>
        <h1 class="page-title">Customers</h1>
        <p class="text-secondary mb-0">Manage and grow your customer network.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Add customer</a>
</div>

<section class="panel">
    <div class="panel-header flex-wrap">
        <div>
            <h2 class="panel-title">All customers</h2>
            <p class="text-secondary small mb-0">@Model.TotalCount customer@(Model.TotalCount == 1 ? "" : "s")</p>
        </div>
        <form asp-action="Index" method="get" class="d-flex gap-2" role="search">
            <input name="search" value="@Model.Search" class="form-control" placeholder="Search customers..." aria-label="Search customers" />
            <input type="hidden" name="sortOrder" value="@Model.SortOrder" />
            <select name="status" class="form-select" aria-label="Filter by status">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<CustomerStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
            <select name="city" class="form-select" aria-label="Filter by city">
                <option value="">All cities</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city" selected="@(Model.City == city)">@city</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i><span class="ms-2 d-none d-sm-inline">Search</span></button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="btn btn-light" asp-action="Index" title="Clear search"><i class="bi bi-x-lg"></i></a>
            }
        </form>
    </div>
    @if (Model.Customers.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-people"></i></div>
            <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "No customers yet" : "No matching customers")</h3>
            <p class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Search) ? "Create your first customer to get started." : "Try a different search term.")</p>
            @if (string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="btn btn-primary" asp-action="Create">Add customer</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th><a class="text-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-city="@Model.City" asp-route-sortOrder="@SortLink("name")">Name <i class="bi bi-arrow-down-up ms-1"></i></a></th>
                        <th><a class="text-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-city="@Model.City" asp-route-sortOrder="@SortLink("company")">Company <i class="bi bi-arrow-down-up ms-1"></i></a></th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th><a class="text-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-city="@Model.City" asp-route-sortOrder="@SortLink("created")">Added <i class="bi bi-arrow-down-up ms-1"></i></a></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td><a class="table-primary-link" asp-action="Details" asp-route-id="@customer.Id">@customer.Name</a></td>
                            <td>@(string.IsNullOrWhiteSpace(customer.Company) ? "—" : customer.Company)</td>
                            <td>@(string.IsNullOrWhiteSpace(customer.Email) ? "—" : customer.Email)</td>
                            <td>@(string.IsNullOrWhiteSpace(customer.Phone) ? "—" : customer.Phone)</td>
                            <td><span class="badge rounded-pill status-@customer.Status.ToString().ToLowerInvariant()">@customer.Status</span></td>
                            <td>@customer.CreatedDate.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@customer.Id" aria-label="Edit @customer.Name"><i class="bi bi-pencil"></i></a>
                                <a class="btn btn-light btn-sm" asp-action="Delete" asp-route-id="@customer.Id" aria-label="Delete @customer.Name"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex align-items-center justify-content-between gap-3 p-3 border-top">
                <span class="small text-secondary">Page @Model.Page of @Model.TotalPages</span>
                <nav aria-label="Customer pages">
                    <ul class="pagination pagination-sm">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-city="@Model.City" asp-route-sortOrder="@Model.SortOrder" asp-route-page="@(Model.Page - 1)" aria-label="Previous page"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-city="@Model.City" asp-route-sortOrder="@Model.SortOrder" asp-route-page="@(Model.Page + 1)" aria-label="Next page"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</section>
