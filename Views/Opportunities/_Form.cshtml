@model Opportunity
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="Id" type="hidden" />
<div class="row g-3">
<div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" class="form-control" /><span asp-validation-for="CustomerId" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" class="form-control" /><span asp-validation-for="LeadId" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" /><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" /><span asp-validation-for="Probability" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Source" class="form-label"></label><input asp-for="Source" class="form-control" /></div>
<div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
</div>
