@model Customer
@{
    ViewData["Title"] = "Edit customer";
}
<div class="page-heading">
    <div><p class="eyebrow mb-2">CUSTOMERS</p><h1 class="page-title">Edit customer</h1><p class="text-secondary mb-0">Update @Model.Name's contact details.</p></div>
</div>
<div class="form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-loading>
        <input type="hidden" asp-for="Id" />
        <partial name="_CustomerForm" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Save changes</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
