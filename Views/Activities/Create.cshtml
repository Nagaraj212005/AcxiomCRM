@model CrmActivity
@{ ViewData["Title"] = "Log activity"; }
<h1 class="h3 mb-4">Log activity</h1>
<form asp-action="Create" method="post" class="card card-body">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
<div class="col-md-8"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select"></select></div>
<div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ActivityStatus>()" class="form-select"></select></div>
<div class="col-md-4"><label asp-for="ActivityDate" class="form-label"></label><input asp-for="ActivityDate" type="datetime-local" class="form-control" /><span asp-validation-for="ActivityDate" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" class="form-control" /></div>
<div class="col-md-4"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" class="form-control" /></div>
<div class="col-md-4"><label asp-for="OpportunityId" class="form-label"></label><input asp-for="OpportunityId" class="form-control" /></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
</div>
<div class="mt-4"><button class="btn btn-primary">Save activity</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
