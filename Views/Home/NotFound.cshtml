@{
    ViewData["Title"] = "Page not found";
}
<section class="empty-state error-state">
    <div class="empty-icon"><i class="bi bi-compass"></i></div>
    <p class="eyebrow mb-2">404 ERROR</p>
    <h1 class="page-title">We couldn't find that page</h1>
    <p class="text-secondary">The link may be incorrect, or the page may have moved.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Back to dashboard</a>
</section>
