@model Lead
@{ ViewData["Title"] = "Add lead"; }
<h1 class="h3 mb-4">Add lead</h1>
<form asp-action="Create" method="post" class="card card-body">
    <partial name="_Form" model="Model" />
    <div class="mt-4"><button class="btn btn-primary" type="submit">Save lead</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
