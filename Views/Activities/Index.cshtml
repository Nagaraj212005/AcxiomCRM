@model IReadOnlyList<CrmActivity>
@{ ViewData["Title"] = "Activities"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Activities</h1><p class="text-secondary mb-0">Calls, meetings, emails, and tasks.</p></div><a asp-action="Create" class="btn btn-primary">Log activity</a></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Activity</th><th>Status</th><th>Customer</th><th>Lead</th><th>Opportunity</th><th>Description</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.ActivityDate.ToLocalTime().ToString("g")</td><td><span class="badge text-bg-light me-1">@item.Type</span>@item.Subject</td><td>@item.Status</td><td>@item.CustomerId</td><td>@item.LeadId</td><td>@item.OpportunityId</td><td>@item.Description</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-5">No activities recorded yet.</td></tr> }
</tbody></table></div></div>
