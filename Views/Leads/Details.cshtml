@model Lead
@{ ViewData["Title"] = "Lead details"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3">@Model.Name</h1><span class="text-secondary">@Model.LeadCode</span></div><div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
@if (Model.Status != LeadStatus.Converted && Model.Status != LeadStatus.Lost) { <form asp-action="Convert" asp-route-id="@Model.Id" method="post" class="d-inline"><button class="btn btn-primary">Convert to customer</button></form> }</div></div>
<div class="card card-body"><dl class="row">
<dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.Company</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Priority</dt><dd class="col-sm-9">@Model.Priority</dd>
<dt class="col-sm-3">Expected value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C")</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd>
</dl><a asp-action="Index" class="btn btn-outline-secondary align-self-start">Back to leads</a></div>
