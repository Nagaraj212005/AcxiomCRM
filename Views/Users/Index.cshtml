@model UserAdministrationViewModel
@{ ViewData["Title"] = "User management"; }
<div class="mb-4"><h1 class="h3 mb-1">User management</h1><p class="text-secondary mb-0">Manage CRM roles and account access.</p></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>User</th><th>Role</th><th>Account</th><th>Access</th></tr></thead><tbody>
@foreach (var user in Model.Users)
{
    <tr>
        <td>@user.Email</td>
        <td><form asp-action="UpdateRole" method="post" class="d-flex gap-2"><input type="hidden" name="userId" value="@user.Id" /><select name="role" class="form-select form-select-sm" aria-label="Role for @user.Email">@foreach (var role in Model.Roles) { <option value="@role" selected="@user.Roles.Contains(role)">@role</option> }</select><button class="btn btn-sm btn-outline-primary">Save</button></form></td>
        <td>@if (user.IsPermanentlyDisabled) { <span class="badge text-bg-danger">Disabled</span> } else if (user.LockoutEnd > DateTimeOffset.UtcNow) { <span class="badge text-bg-warning">Temporarily locked</span> } else { <span class="badge text-bg-success">Enabled</span> }</td>
        <td><form asp-action="SetEnabled" method="post"><input type="hidden" name="userId" value="@user.Id" /><input type="hidden" name="enabled" value="@(!user.IsPermanentlyDisabled)" /><button class="btn btn-sm @(user.IsPermanentlyDisabled ? "btn-success" : "btn-outline-danger")">@(user.IsPermanentlyDisabled ? "Enable" : "Disable")</button></form></td>
    </tr>
}
</tbody></table></div></div>
