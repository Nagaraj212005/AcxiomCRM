@model FollowUp
@{ ViewData["Title"] = "Schedule follow-up"; }
<h1 class="h3 mb-4">Schedule follow-up</h1><form asp-action="Create" method="post" class="card card-body"><partial name="_Form" model="Model" /><div class="mt-4"><button class="btn btn-primary">Save follow-up</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
